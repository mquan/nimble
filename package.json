{
  "name": "mini-mcp",
  "version": "0.1.0",
  "description": "MCP tool router that scales to thousands of tools without the token tax",
  "author": "Quan Nguyen",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "rm -rf dist && npm run build && node --test dist/tests/*.js",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:preview": "vite preview --config ui/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1",
    "better-sqlite3": "^12.5.0",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/prismjs": "^1.26.5",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
