{
  "name": "nimble-mcp",
  "version": "0.5.2",
  "description": "A token-efficient MCP server that lazy loads tools and proxy tool calls",
  "homepage": "https://github.com/mquan/nimble",
  "keywords": [
    "mcp",
    "LLM tokens",
    "LLM cost"
  ],
  "author": "Quan Nguyen",
  "type": "module",
  "bin": {
    "nimble-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run ui:build && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "test": "rm -rf dist && npm run build && node --test dist/tests/*.js",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:preview": "vite preview --config ui/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1",
    "better-sqlite3": "^12.5.0",
    "openai": "^6.15.0",
    "prismjs": "^1.29.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.0"
  }
}
